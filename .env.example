# Contact form email settings — copy this file to .env.local and fill it in.
# With Gmail: enable 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=opololinda@gmail.com
SMTP_PASS=your-16-char-app-password

# Where submissions are delivered (defaults to SMTP_USER if unset)
CONTACT_TO=opololinda@gmail.com
